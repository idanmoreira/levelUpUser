{
  "name": "levelup-user",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run quality:bundle",
    "ci": "npm run validate",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && biome check .",
    "lint:commits": "commitlint --last --verbose",
    "quality:architecture": "depcruise src --include-only '^src' --ts-config tsconfig.app.json",
    "quality:dead-code": "knip",
    "quality:bundle": "node scripts/check-bundle.mjs",
    "quality:security": "npm audit --omit=dev",
    "quality": "npm run quality:architecture && npm run quality:dead-code && npm run quality:security",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "validate": "npm run lint && npm run quality && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@sentry/react": "^10.51.0",
    "liquid-gl": "2.0.1",
    "motion": "13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "web-vitals": "6.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "17.4.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "27.0.1",
    "knip": "6.32.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.10",
    "vitest": "4.1.10"
  }
}
